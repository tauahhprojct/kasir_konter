rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isShopOwner(shopId) {
      return isVerified()
        && isValidId(shopId)
        && request.auth.uid == shopId
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isValidShop(data) {
      return data.keys().hasAll(['ownerId', 'shopName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'shopName', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.shopName is string
        && data.shopName.size() >= 1
        && data.shopName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['ownerId', 'name', 'kind', 'balance', 'lowThreshold', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'kind', 'balance', 'lowThreshold', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.kind in ['cash', 'bank', 'server']
        && data.balance is number
        && data.lowThreshold is number
        && data.lowThreshold >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'ownerId',
          'type',
          'category',
          'productName',
          'costPrice',
          'sellPrice',
          'adminFee',
          'profit',
          'status',
          'sourceWalletId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'type',
          'category',
          'productName',
          'targetNumber',
          'customerName',
          'customerPhone',
          'costPrice',
          'sellPrice',
          'adminFee',
          'profit',
          'status',
          'sourceWalletId',
          'destinationWalletId',
          'notes',
          'paidAt',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.type in ['sale', 'expense', 'topup', 'adjustment']
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.productName is string
        && data.productName.size() >= 1
        && data.productName.size() <= 120
        && (!('targetNumber' in data) || (data.targetNumber is string && data.targetNumber.size() <= 40))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 80))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 30))
        && data.costPrice is number
        && data.costPrice >= 0
        && data.sellPrice is number
        && data.sellPrice >= 0
        && data.adminFee is number
        && data.adminFee >= 0
        && data.profit is number
        && data.status in ['paid', 'kasbon']
        && data.sourceWalletId is string
        && isValidId(data.sourceWalletId)
        && (!('destinationWalletId' in data) || (data.destinationWalletId is string && isValidId(data.destinationWalletId)))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && (!('paidAt' in data) || data.paidAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProductPreset(data) {
      return data.keys().hasAll(['ownerId', 'name', 'category', 'costPrice', 'sellPrice', 'defaultServerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'category', 'costPrice', 'sellPrice', 'defaultServerId', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.costPrice is number
        && data.costPrice > 0
        && data.sellPrice is number
        && data.sellPrice > 0
        && data.defaultServerId is string
        && isValidId(data.defaultServerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditRecord(data) {
      return data.keys().hasAll(['ownerId', 'walletId', 'walletName', 'systemBalance', 'actualBalance', 'difference', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'walletId', 'walletName', 'systemBalance', 'actualBalance', 'difference', 'notes', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.walletId is string
        && isValidId(data.walletId)
        && data.walletName is string
        && data.walletName.size() >= 1
        && data.walletName.size() <= 60
        && data.systemBalance is number
        && data.actualBalance is number
        && data.difference is number
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /shops/{shopId} {
      allow get: if isVerified() && isValidId(shopId) && request.auth.uid == shopId && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(shopId)
        && request.auth.uid == shopId
        && isValidShop(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(shopId)
        && request.auth.uid == shopId
        && isValidShop(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'updatedAt']);
      allow delete: if false;

      match /wallets/{walletId} {
        allow get: if isValidId(walletId) && isShopOwner(shopId);
        allow list: if isVerified() && request.auth.uid == shopId && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(walletId)
          && isShopOwner(shopId)
          && isValidWallet(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(walletId)
          && isValidWallet(incoming())
          && isShopOwner(shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'balance', 'updatedAt'])
          );
        allow delete: if isValidId(walletId) && isShopOwner(shopId);
      }

      match /transactions/{transactionId} {
        allow get: if isValidId(transactionId) && isShopOwner(shopId);
        allow list: if isVerified() && request.auth.uid == shopId && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(transactionId)
          && isShopOwner(shopId)
          && isValidTransaction(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (!('paidAt' in incoming()) || incoming().paidAt == request.time);
        allow update: if isValidId(transactionId)
          && isValidTransaction(incoming())
          && isShopOwner(shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().status == 'kasbon'
          && incoming().status == 'paid'
          && 'destinationWalletId' in incoming()
          && incoming().paidAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'destinationWalletId', 'paidAt', 'updatedAt']);
        allow delete: if isValidId(transactionId) && isShopOwner(shopId);
      }

      match /products/{productId} {
        allow get: if isValidId(productId) && isShopOwner(shopId);
        allow list: if isVerified() && request.auth.uid == shopId && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(productId)
          && isShopOwner(shopId)
          && isValidProductPreset(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(productId)
          && isValidProductPreset(incoming())
          && isShopOwner(shopId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'costPrice', 'sellPrice', 'defaultServerId', 'updatedAt']);
        allow delete: if isValidId(productId) && isShopOwner(shopId);
      }

      match /audits/{auditId} {
        allow get: if isValidId(auditId) && isShopOwner(shopId);
        allow list: if isVerified() && request.auth.uid == shopId && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(auditId)
          && isShopOwner(shopId)
          && isValidAuditRecord(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(auditId) && isShopOwner(shopId);
      }
    }
  }
}
