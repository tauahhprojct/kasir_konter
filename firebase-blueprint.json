{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Konter pulsa and PPOB shop profile owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the shop owner."
        },
        "shopName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Display name of the pulsa & PPOB shop."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["ownerId", "shopName", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Cash drawer, bank/QRIS account, or pulsa/PPOB server balance.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the shop owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Wallet or server name."
        },
        "kind": {
          "type": "string",
          "enum": ["cash", "bank", "server"],
          "description": "Type of wallet."
        },
        "balance": {
          "type": "number",
          "description": "Current IDR balance."
        },
        "lowThreshold": {
          "type": "number",
          "description": "Low-balance warning threshold in IDR."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["ownerId", "name", "kind", "balance", "lowThreshold", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Pulsa/PPOB sale, operational expense/prive, server deposit top-up, or audit adjustment.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the shop owner."
        },
        "type": {
          "type": "string",
          "enum": ["sale", "expense", "topup", "adjustment"],
          "description": "Ledger entry type."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Product or expense category."
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Product name or expense description."
        },
        "targetNumber": {
          "type": "string",
          "maxLength": 40,
          "description": "Destination phone number or PLN/PPOB customer ID."
        },
        "customerName": {
          "type": "string",
          "maxLength": 80,
          "description": "Customer name for sales or kasbon."
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Customer WhatsApp number for kasbon reminders."
        },
        "costPrice": {
          "type": "number",
          "description": "Cost of goods / expense amount / top-up nominal."
        },
        "sellPrice": {
          "type": "number",
          "description": "Selling price to customer."
        },
        "adminFee": {
          "type": "number",
          "description": "Transfer or bank admin fee."
        },
        "profit": {
          "type": "number",
          "description": "Net profit or cash impact."
        },
        "status": {
          "type": "string",
          "enum": ["paid", "kasbon"],
          "description": "Payment settlement status."
        },
        "sourceWalletId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Source wallet ID."
        },
        "destinationWalletId": {
          "type": "string",
          "maxLength": 128,
          "description": "Destination wallet ID if applicable."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional notes."
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when payment was settled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "type",
        "category",
        "productName",
        "costPrice",
        "sellPrice",
        "adminFee",
        "profit",
        "status",
        "sourceWalletId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProductPreset": {
      "title": "ProductPreset",
      "description": "Quick-fill product catalog item with modal and selling prices.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the shop owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Product display name."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Product category."
        },
        "costPrice": {
          "type": "number",
          "description": "Cost price in IDR."
        },
        "sellPrice": {
          "type": "number",
          "description": "Selling price in IDR."
        },
        "defaultServerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Default server wallet ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "name", "category", "costPrice", "sellPrice", "defaultServerId", "createdAt", "updatedAt"]
    },
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "Daily closing balance reconciliation check.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the shop owner."
        },
        "walletId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Audited wallet ID."
        },
        "walletName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Wallet name snapshot."
        },
        "systemBalance": {
          "type": "number",
          "description": "Expected system balance."
        },
        "actualBalance": {
          "type": "number",
          "description": "Actual counted balance."
        },
        "difference": {
          "type": "number",
          "description": "Difference (actual - system)."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional audit note."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "walletId", "walletName", "systemBalance", "actualBalance", "difference", "createdAt"]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Shop root profile document keyed by owner UID."
    },
    "/shops/{shopId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Cash, bank/QRIS, and server balance wallets belonging to a shop."
    },
    "/shops/{shopId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Sales, expenses, server top-ups, and audit adjustments belonging to a shop."
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": { "$ref": "#/entities/ProductPreset" },
      "description": "Product pricing presets belonging to a shop."
    },
    "/shops/{shopId}/audits/{auditId}": {
      "schema": { "$ref": "#/entities/AuditRecord" },
      "description": "Daily closing reconciliation audits belonging to a shop."
    }
  }
}
